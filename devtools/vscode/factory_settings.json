{
  "json.schemas": [
    {
      "fileMatch": [
        "*.test_list.json"
      ],
      "url": "file://${factoryFolder}/py_pkg/cros/factory/test/test_lists/test_list.schema.json"
    },
    {
      "fileMatch": [
        "py/goofy/*/manifest.json"
      ],
      "url": "https://json.schemastore.org/chrome-manifest"
    },
    {
      "fileMatch": [
        "py/goofy/plugins/goofy_plugin*.json"
      ],
      "url": "file://${factoryFolder}/py_pkg/cros/factory/goofy/plugins/plugins.schema.json"
    }
  ],
  "python.defaultInterpreterPath": "/usr/bin/python3.8",
  "python.autoComplete.extraPaths": [
    "${factoryFolder}/py_pkg"
  ],
  "python.analysis.extraPaths": [
    "${factoryFolder}/py_pkg"
  ],
  "[python]": {
    "editor.defaultFormatter": "eeyore.yapf"
  },
  "isort.args": [
    "--settings-path=${factoryFolder}/devtools/vscode/.isort.cfg"
  ]
}
