{
  "inherit": [
    "generic_common.test_list"
  ],
  "definitions": {
    "GetIntelDescriptorStatus": {
      "pytest_name": "get_intel_desc_status",
      "__comment": "Get the status of Intel Descriptor (locked/unlocked). This test item should be run before LockIntelDescriptor and PSR test groups."
    },
    "LockIntelDescriptor": {
      "label": "Lock the Intel Descriptor",
      "run_if": "(constants.grt.force_write_protect or constants.phase == 'PVT') and not device.factory.intel_desc_locked",
      "subtests": [
        {
          "pytest_name": "update_firmware",
          "args": {
            "unlock_csme": false
          }
        },
        "Barrier",
        "FullRebootStep"
      ]
    },
    "SetEOMNVAR": {
      "pytest_name": "setup_psr_feature",
      "label": "Set EOM NVAR",
      "args": {
        "action": "set"
      }
    },
    "StartPSRLog": {
      "pytest_name": "setup_psr_feature",
      "label": "Start PSR Log",
      "args": {
        "action": "start"
      }
    },
    "StartPSRLogGroup": {
      "run_if": "not device.factory.intel_desc_locked",
      "__comment": "Put this test right before GRTFinalize to minimize logging",
      "subtests": [
        "SetEOMNVAR",
        {
          "inherit": "FullRebootStep",
          "run_if": "device.factory.psr_update_need_reboot"
        },
        {
          "inherit": "SyncFactoryServer",
          "run_if": "device.factory.psr_update_need_reboot"
        },
        "StartPSRLog"
      ]
    },
    "UpdateIntelFirmware": {
      "label": "Update Intel Firmware",
      "__comment": "Depending on the current descriptor status, DUT will be updated with lock/unlocked FW.",
      "subtests": [
        "GetIntelDescriptorStatus",
        {
          "pytest_name": "update_firmware",
          "args": {
            "unlock_csme": "eval! not device.factory.intel_desc_locked"
          }
        },
        "Barrier",
        "FullRebootStep"
      ]
    },
    "UpdatePSROEMData": {
      "pytest_name": "update_psr_oem_data",
      "run_if": "not device.factory.intel_desc_locked",
      "args": {
        "update_from_config": false,
        "oem_data_value": {
          "OEM Name": "Google",
          "OEM Make": "ChromeOS",
          "OEM Model": "MTL vPro",
          "Country of Manufacturer": "TW"
        }
      }
    }
  }
}
