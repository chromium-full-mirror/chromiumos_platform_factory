{
  "inherit": [
    "generic_fingerprint.test_list"
  ],
  "label": "Generic Fingerprint Sensor Factory tests",
  "constants": {},
  "options": {
    "auto_run_on_start": false
  },
  "definitions": {
    "ElanFPSBaseTest": {
      "inherit": "ElanFPSTest",
      "label": "Elan Fingerprint Sensor Base Test",
      "args": {
        "test_case": 1
      }
    },
    "ElanFPSCompleteTest": {
      "inherit": "ElanFPSTest",
      "label": "Elan Fingerprint Sensor Complete Test",
      "args": {
        "test_case": 15
      }
    },
    "ElanFPSNonInteractiveTest": {
      "inherit": "ElanFPSTest",
      "label": "Elan Fingerprint Sensor Non-interactive Test",
      "args": {
        "test_case": 7
      }
    },
    "ElanFPSResetTest": {
      "inherit": "ElanFPSTest",
      "label": "Elan Fingerprint Sensor Reset Test",
      "args": {
        "test_case": 4
      }
    },
    "ElanFPSSensorTest": {
      "inherit": "ElanFPSTest",
      "label": "Elan Fingerprint Sensor Sensor Test",
      "args": {
        "test_case": 2
      }
    },
    "ElanFPSTests": {
      "inherit": "TestGroup",
      "label": "Elan Fingerprint Sensor Tests",
      "subtests": [
        "ElanFPSBaseTest",
        "ElanFPSSensorTest",
        "ElanFPSResetTest",
        "ElanFPSWOETest",
        "ElanFPSNonInteractiveTest",
        "ElanFPSCompleteTest"
      ]
    },
    "ElanFPSWOETest": {
      "inherit": "ElanFPSTest",
      "label": "Elan Fingerprint Sensor WOE Test",
      "args": {
        "test_case": 8
      }
    },
    "FPCFPSTestPlusManualTest": {
      "inherit": "FPCFPSTest",
      "label": "FPC Fingerprint Sensor Test + Manual Test",
      "args": {
        "number_of_manual_captures": 10
      }
    },
    "FPCFPSTestPlusPixelMedianTestForBloonchipper": {
