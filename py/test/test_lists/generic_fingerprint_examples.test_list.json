    "FPCFPSTestPlusRubberStamperTest": {
      "inherit": "FPCFPSTest",
      "label": "FPC Fingerprint Sensor Test + Rubber Stamper Test",
      "args": {
        "rubber_finger_present": true
      }
    },
    "FPCFPSTests": {
      "inherit": "TestGroup",
      "label": "FPC Fingerprint Sensor Tests",
      "subtests": [
        "FPCFPSTest",
        "FPCFPSTestPlusManualTest",
        "FPCFPSTestPlusPixelMedianTestForDartmonkey",
        "FPCFPSTestPlusPixelMedianTestForBloonchipper",
        "FPCFPSTestPlusRubberStamperTest"
      ]
    },
    "FPSTestHelpers": {
      "inherit": "TestGroup",
      "label": "Fingerprint Sensor Test Helpers",
      "subtests": [
        "SetHasFingerprint",
        "UnsetHasFingerprint",
        "ProbeFingerprintSensor",
        "UpdateFPFirmware",
        "CheckFPFirmware",
        "UpdateFPFirmwareWithLocalBuildFirmware"
      ]
    },
    "ProbeFingerprintSensor": {
      "pytest_name": "probe.probe",
      "label": "Probe Fingerprint Sensor",
      "args": {
        "component_list": [
          "fingerprint"
        ],
        "config_file": "/usr/local/factory/py/hwid/v3/default_probe_statement.json",
        "overridden_rules": [
          [
            "fingerprint",
            "==",
            1
          ]
        ]
      }
    },
    "SetHasFingerprint": {
      "pytest_name": "exec_shell",
      "label": "Set Has Fingerprint",
      "related_components": [
        "test_tags.TestCategory.FINGERPRINT_SENSOR"
      ],
      "args": {
        "commands": "factory device-data component.has_fingerprint=1"
      }
    },
    "UnsetHasFingerprint": {
      "pytest_name": "exec_shell",
      "label": "Unset Has Fingerprint",
      "related_components": [
        "test_tags.TestCategory.FINGERPRINT_SENSOR"
      ],
      "args": {
        "commands": "factory device-data component.has_fingerprint=0"
      }
    },
    "UpdateFPFirmwareWithLocalBuildFirmware": {
      "pytest_name": "update_fpmcu_firmware",
      "label": "Update Fingerprint Firmware with Local Build Firmware",
      "args": {
        "method": "UPDATE",
        "firmware_file": "/path/to/image.bin"
      }
    }
  },
  "tests": [
    "FPSTestHelpers",
    "ElanFPSTests",
    "FPCFPSTests"
  ]
}
