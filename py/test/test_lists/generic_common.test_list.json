          "args": {
            "enable_swwp": true,
            "two_stages": "eval! constants.factory_process == 'TWOSTAGES'"
          }
        },
        {
          "pytest_name": "ti50_ap_ro_verification",
          "label": "Ti50 AP RO Verification (pre-PVT)",
          "run_if": "constants.phase != 'PVT'",
          "allow_reboot": true,
          "args": {
            "enable_swwp": false,
            "two_stages": "eval! constants.factory_process == 'TWOSTAGES'"
          }
        }
      ]
