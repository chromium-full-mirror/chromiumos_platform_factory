{
  "__comment": "Predefined touchpad tests. Touchpad is called \"Touchpad Controller\" in AVL.",
  "inherit": [
    "generic_common.test_list"
  ],
  "constants": {
    "__comment": "has_device_data is defined in generic_common."
  },
  "options": {},
  "definitions": {
    "ProbeTouchpad": {
      "pytest_name": "probe.probe",
      "label": "Probe Touchpad",
      "args": {
        "component_list": [
          "touchpad"
        ],
        "config_file": "/usr/local/factory/py/hwid/v3/default_probe_statement.json",
        "overridden_rules": [
          [
            "touchpad",
            "==",
            1
          ]
        ]
      }
    },
    "Touchpad": {
      "pytest_name": "touchpad"
    }
  }
}
