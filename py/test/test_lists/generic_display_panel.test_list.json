{
  "__comment": "Predefined display_panel tests. display_panel is called \"Display Panel\" in AVL.",
  "inherit": [
    "base.test_list"
  ],
  "constants": {},
  "options": {},
  "definitions": {
    "Backlight": {
      "pytest_name": "backlight"
    },
    "Display": {
      "pytest_name": "display"
    },
    "DisplayPoint": {
      "pytest_name": "display_point",
      "args": {
        "point_size": 3.0,
        "max_point_count": 5
      }
    },
    "EDPPanelTiming": {
      "pytest_name": "edp_panel_timing"
    },
    "ProbeDisplayPanel": {
      "pytest_name": "probe.probe",
      "label": "Probe Display Panel",
      "args": {
        "component_list": [
          "display_panel"
        ],
        "config_file": "/usr/local/factory/py/hwid/v3/default_probe_statement.json",
        "overridden_rules": [
          [
            "display_panel",
            "==",
            1
          ]
        ]
      }
    }
  }
}
