{
  "inherit": [
    "generic_camera.test_list"
  ],
  "label": "Generic Camera Factory tests",
  "constants": {},
  "options": {
    "auto_run_on_start": false
  },
  "definitions": {
    "CameraTests": {
      "inherit": "TestGroup",
      "subtests": [
        "SetHasFrontCamera",
        "SetHasRearCamera",
        "ProbeOneCamera",
        "FrontCameraFace",
        "FrontCameraLED",
        "FrontCameraManual",
        "FrontCameraManualOpenCV",
        "FrontCameraQRScan",
        "FrontCameraQRScan1920x1080",
        "FrontCameraStress",
        "FrontCameraFrames",
        "FrontCameraAssemble",
        "FrontCameraAssembleQR",
        "FrontCameraAssemble07",
        "FrontCameraBrightness",
        "CameraNoCharacteristics",
        "ProbeTwoCameras",
        "RearCameraFace",
        "RearCameraLED",
        "RearCameraManual",
        "RearCameraManualOpenCV",
        "RearCameraQRScan",
        "RearCameraAssemble",
        "RearCameraAssembleQR",
        "RearCameraStress",
        "UnsetHasFrontCamera",
        "UnsetHasRearCamera"
      ]
    },
    "FrontCameraAssemble07": {
      "inherit": "FrontCameraAssemble",
      "label": "Front Camera Assemble 07",
      "args": {
        "min_luminance_ratio": 0.7
      }
    },
    "FrontCameraBrightness": {
      "inherit": "FrontCamera",
      "label": "Front Camera Brightness",
      "args": {
        "num_frames_to_pass": 5,
        "mode": "brightness",
        "timeout_secs": 3,
        "brightness_range": [
          null,
          10
        ]
      }
    },
    "FrontCameraFrames": {
      "inherit": "FrontCamera",
      "label": "Front Camera Frames",
      "args": {
        "num_frames_to_pass": 100,
        "mode": "frame_count",
        "timeout_secs": 1000,
        "show_image": false
      }
    },
    "FrontCameraManualOpenCV": {
      "inherit": "FrontCameraManual",
      "label": "Front Camera Manual OpenCV",
      "args": {
        "e2e_mode": false
      }
    },
    "FrontCameraQRScan": {
      "inherit": "FrontCamera",
      "args": {
        "QR_string": "Hello ChromeOS!"
      }
    },
    "FrontCameraQRScan1920x1080": {
      "inherit": "FrontCameraQRScan",
      "label": "Front Camera QR Scan 1920x1080",
      "args": {
        "camera_args": {
          "resolution": [
            1920,
            1080
          ]
        }
      }
    },
    "FrontCameraStress": {
      "inherit": "FrontCamera",
      "label": "Front Camera Stress",
      "args": {
        "mode": "timeout",
        "timeout_secs": 1000,
        "show_image": false
      }
    },
    "ProbeOneCamera": {
      "inherit": "ProbeCamera",
      "label": "Probe One Camera",
      "args": {
        "overridden_rules": [
          [
            "camera",
            "==",
            1
          ]
        ]
      }
    },
    "ProbeTwoCameras": {
      "inherit": "ProbeCamera",
      "label": "Probe Two Cameras",
      "args": {
        "overridden_rules": [
          [
            "camera",
            "==",
            2
          ]
        ]
      }
    },
    "RearCameraManualOpenCV": {
      "inherit": "RearCameraManual",
      "label": "Rear Camera Manual OpenCV",
      "args": {
        "e2e_mode": false
      }
    },
    "RearCameraQRScan": {
      "inherit": "RearCamera",
      "args": {
        "QR_string": "Hello ChromeOS!"
      }
    },
    "RearCameraStress": {
      "inherit": "RearCamera",
      "label": "Rear Camera Stress",
      "args": {
        "mode": "timeout",
        "timeout_secs": 1000,
        "show_image": false
      }
    },
    "SetHasFrontCamera": {
      "pytest_name": "exec_shell",
      "label": "Set Has Front Camera",
      "related_components": [
        "test_tags.TestCategory.Camera"
      ],
      "args": {
        "commands": "factory device-data component.has_front_camera=1"
      }
    },
    "SetHasRearCamera": {
      "pytest_name": "exec_shell",
      "label": "Set Has Rear Camera",
      "related_components": [
        "test_tags.TestCategory.Camera"
      ],
      "args": {
        "commands": "factory device-data component.has_rear_camera=1"
      }
    },
    "UnsetHasFrontCamera": {
      "pytest_name": "exec_shell",
      "label": "Unset Has Front Camera",
      "related_components": [
        "test_tags.TestCategory.Camera"
      ],
      "args": {
        "commands": "factory device-data component.has_front_camera=0"
      }
    },
    "UnsetHasRearCamera": {
      "pytest_name": "exec_shell",
      "label": "Unset Has Rear Camera",
      "related_components": [
        "test_tags.TestCategory.Camera"
      ],
      "args": {
        "commands": "factory device-data component.has_rear_camera=0"
      }
    }
  },
  "tests": [
    "CameraTests"
  ]
}
