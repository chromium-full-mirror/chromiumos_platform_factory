{
  "__comment": "Examples for testing storage components.",
  "inherit": [
    "generic_storage.test_list"
  ],
  "label": "Generic Storage Factory tests",
  "constants": {},
  "options": {
    "auto_run_on_start": false
  },
  "definitions": {
    "BadBlocks2GB": {
      "inherit": "BadBlocks",
      "label": "Bad Blocks 2GB",
      "args": {
        "max_bytes": 2147483648
      }
    },
    "BadBlocksForceOnSSD": {
      "inherit": "BadBlocks",
      "label": "Bad Blocks Force badblocks On SSD",
      "args": {
        "force_badblocks_on_ssd": true
      }
    },
    "BadBlocksForceOnSSD10MB": {
      "inherit": "BadBlocksForceOnSSD",
      "label": "Bad Blocks Force badblocks On SSD 10MB",
      "args": {
        "max_bytes": 10240
      }
    },
    "StorageSimpleStress": {
      "pytest_name": "storage_simple_stress",
      "args": {
        "operations": 1,
        "dir": "/home/root",
        "file_size": 10485760
      }
    },
    "StorageSimpleStress3Times": {
      "inherit": "StorageSimpleStress",
      "label": "Storage Simple Stress 3 Times",
      "args": {
        "operations": 3,
        "dir": "/home/root",
        "file_size": 10485760
      }
    },
    "StorageTests": {
      "inherit": "TestGroup",
      "subtests": [
        "ProbeStorage",
        "BadBlocks",
        "BadBlocks2GB",
        "BadBlocksForceOnSSD",
        "BadBlocksForceOnSSD10MB",
        "StorageSimpleStress",
        "StorageSimpleStress3Times",
        "VerifyRootPartition"
      ]
    }
  },
  "tests": [
    "StorageTests"
  ]
}
