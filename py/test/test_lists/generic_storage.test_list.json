{
  "__comment": "Predefined storage tests.",
  "inherit": [
    "base.test_list"
  ],
  "constants": {},
  "options": {},
  "definitions": {
    "BadBlocks": {
      "pytest_name": "bad_blocks",
      "__comment": "When run alone, this takes ~.5s/MiB (for four passes).  We'll do a gigabyte, which takes about 9 minutes.",
      "args": {
        "timeout_secs": 120,
        "log_threshold_secs": 10,
        "max_bytes": 1073741824
      }
    },
    "ProbeStorage": {
      "pytest_name": "probe.probe",
      "label": "Probe Storage",
      "args": {
        "component_list": [
          "storage"
        ],
        "config_file": "/usr/local/factory/py/hwid/v3/default_probe_statement.json",
        "overridden_rules": [
          [
            "storage",
            ">",
            0
          ]
        ]
      }
    },
    "VerifyRootPartition": {
      "pytest_name": "verify_root_partition",
      "args": {
        "max_bytes": 1048576
      }
    }
  }
}
