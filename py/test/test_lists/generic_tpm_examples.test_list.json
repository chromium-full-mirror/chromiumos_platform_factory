{
  "__comment": "Examples for testing TPM. TPM is called \"TPM\", or \"Secure Element\" in AVL.",
  "inherit": [
    "generic_tpm.test_list"
  ],
  "label": "Generic TPM Factory tests",
  "constants": {},
  "options": {
    "auto_run_on_start": false
  },
  "definitions": {
    "AssertGSCBoardIDIsPrePVT": {
      "pytest_name": "check_cr50_board_id",
      "label": "Assert GSC Board ID flags is pre-pvt",
      "args": {
        "board_id_flags": "PHASE_PREPVT"
      }
    },
    "CommonTests": {
      "inherit": "TestGroup",
      "subtests": [
        "ProbeTPM",
        "CheckSecdataVersion",
        "AssertGSCBoardIDIsUnset",
        "AssertGSCBoardIDIsPrePVT",
        "UpdateGSCFirmwareWithoutUpstart",
        "ClearTPMOwnerRequestGroup",
        "TPMState",
        "TPMVerifyEKGroup"
      ]
    },
    "Cr50APROVerificationManual": {
      "pytest_name": "cr50_ap_ro_verification",
      "label": "Cr50 AP RO Verification Manual",
      "allow_reboot": true,
      "args": {
        "timeout_secs": 5,
        "manual_test": true
      }
    },
    "Cr50Tests": {
      "inherit": "TestGroup",
      "subtests": [
        "UpdateCr50Firmware"
      ]
    },
    "ProbeTPM": {
      "pytest_name": "probe.probe",
      "label": "Probe TPM",
      "args": {
        "component_list": [
          "tpm"
        ],
        "config_file": "/usr/local/factory/py/hwid/v3/default_probe_statement.json",
        "overridden_rules": [
          [
            "tpm",
            "==",
            1
          ]
        ]
      }
    },
    "TPMTests": {
      "inherit": "TestGroup",
      "subtests": [
        "CommonTests",
        "Cr50Tests",
        "Ti50Tests"
      ]
    },
    "Ti50Tests": {
      "inherit": "TestGroup",
      "subtests": [
        "UpdateTi50Firmware",
        "UpdateTi50From0o0o15To0o0o16",
        "Ti50APROVerification"
      ]
    },
    "UpdateGSCFirmwareWithoutUpstart": {
      "pytest_name": "update_cr50_firmware",
      "label": "Update GSC Firmware without upstart",
      "allow_reboot": true,
      "args": {
        "upstart_mode": false
      }
    },
    "UpdateTi50From0o0o15To0o0o16": {
      "inherit": "UpdateGSCFirmwareWithoutUpstart",
      "label": "Update Ti50 Firmware from 0.0.15- to 0.0.16+",
      "args": {
        "firmware_file": "/path/to/ti50.bin.prepvt",
        "skip_prepvt_flag_check": "eval! constants.phase != 'PVT'",
        "force_ro_mode": true
      }
    }
  },
  "tests": [
    "TPMTests"
  ]
}
