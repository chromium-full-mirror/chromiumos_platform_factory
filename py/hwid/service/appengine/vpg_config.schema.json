{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "boards": {
      "type": "string"
    },
    "models": {
      "type": "string"
    },
    "component_category": {
      "type": "string"
    },
    "vpg_config": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "properties": {
            "waived_comp_categories": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/component_category"
                  }
                }
              ]
            },
            "ignore_error": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/component_category"
                  }
                }
              ]
            },
            "encrypted": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "properties": {
    "boards_vp_on": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/boards"
      },
      "$ref": "#/definitions/vpg_config"
    },
    "models_force_vp_on": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/boards"
      },
      "patternProperties": {
        ".*": {
          "propertyNames": {
            "$ref": "#/definitions/models"
          },
          "$ref": "#/definitions/vpg_config"
        }
      }
    },
    "models_force_vp_off": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/boards"
      },
      "patternProperties": {
        ".*": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/models"
          }
        }
      }
    }
  }
}
